# Committed defaults for the demo stack. No secrets here.
# Copy demo.env.example to demo.env.local for the live DeepSeek run; compose loads it after this file,
# so later values win. demo.env.local is git-ignored.
ENV=local
AUTH_MODE=demo
PERSISTENCE=postgres
LOG_LEVEL=INFO

# Scripted provider: stances are derived from the persona cards, arguments are labelled [synthetic],
# and /readyz reports llm: scripted. Switch in demo.env.local for the live demo.
LLM_PROVIDER=scripted
LLM_MODEL=deepseek-flash
SIMULATION_MODEL_ID=scripted-local
SIMULATION_INPUT_PRICE_PER_1K=0
SIMULATION_OUTPUT_PRICE_PER_1K=0
SIMULATION_ALLOW_ZERO_PRICE=true

# 0 = ingest your own corpus; 1 = run the one-document sample seed before serving.
HPS_SEED_ON_BOOT=0
