# Local configuration example — copy to `.env`: `cp .env.example .env`
#
# Only variables that must be provided are active below. Everything else has a safe default in
# `src/shared/config.py`; uncomment a line to override it.
#
#   ENV                   local | staging | production            (default: local)
#   AUTH_MODE             demo | strict                           (default: demo)
#                         demo is refused when ENV=production (ADR-005)
#   PERSISTENCE           postgres | memory                       (default: postgres)
#                         memory is refused outside ENV=local; it is for tests and a
#                         database-less local demo only (restart loses the corpus)
#   DB_ECHO               true | false                            (default: false)
#   DB_POOL_SIZE          int, 1-50                               (default: 5)
#   DB_MAX_OVERFLOW       int, 0-50                               (default: 5)
#   DB_CONNECT_TIMEOUT_S  float, seconds                          (default: 5.0)
#   LOG_LEVEL             DEBUG | INFO | WARNING | ERROR          (default: INFO)
#   LOG_FORMAT            json | console                          (default: json)
#   API_HOST              bind address                            (default: 0.0.0.0)
#   API_PORT              listen port                             (default: 8000)
#   CORS_ORIGINS          JSON array, e.g. ["http://localhost:3000"] (default: [])

# PostgreSQL 16 + pgvector (see compose.yaml). The asyncpg driver is mandatory.
DATABASE_URL=postgresql+asyncpg://hps:hps@localhost:5433/health_policy
# Optional: /readyz probes this URL for LLM reachability. Unset reports "not_configured".
# NOTE: no LLM adapter is wired. The simulation uses ScriptedLLMClient, which echoes its prompt and
# reports synthetic token counts; decisions (positions, arguments) are supplied by the client. (#416)
# Simulation metering. Prices are EUR per 1k tokens; both default to 0.0, and zero prices are refused at
# boot only when SIMULATION_ALLOW_ZERO_PRICE=false (the default is true so a local demo boots unpriced).
#   SIMULATION_MODEL_ID             configured model id                (default: scripted-local)
#   SIMULATION_INPUT_PRICE_PER_1K   EUR per 1k input tokens           (default: 0.0)
#   SIMULATION_OUTPUT_PRICE_PER_1K  EUR per 1k output tokens          (default: 0.0)
#   SIMULATION_ALLOW_ZERO_PRICE     true | false                      (default: true)
#   SIMULATION_STREAM_IDLE_S        max idle seconds before close     (default: 3600)
#   SIMULATION_STREAM_HEARTBEAT_S   heartbeat seconds while idle      (default: 15)
# /readyz reports `simulation_pricing: configured|zero` so an unpriced deployment is visible.
# LLM_HEALTH_URL=http://llm:8080/health
