# Live-model overrides for the demo stack — copy to `demo.env.local` (git-ignored) and fill in the key.
#
#   cp demo.env.example demo.env.local
#   docker compose up -d --force-recreate backend
#   curl -s localhost:3000/api/hps/_platform/readyz | jq .checks.llm   # expect "openai-compatible"
#
# compose loads demo.env (committed defaults: scripted) first and demo.env.local second, so these win.

LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=800

# Metering. Prices are per 1k tokens in the currency you report: the UI formats EUR, DeepSeek bills
# USD — either label the number as USD on stage or convert, but do not mix the two.
# deepseek-chat list prices (cache miss) ≈ $0.27 / 1M input, $1.10 / 1M output:
SIMULATION_MODEL_ID=deepseek-chat
SIMULATION_INPUT_PRICE_PER_1K=0.00027
SIMULATION_OUTPUT_PRICE_PER_1K=0.0011
# With a real provider, zero prices would meter every call at cost 0 and the budget guard could only
# stop by invocation count. Keep this false and the prices above in sync with the provider.
SIMULATION_ALLOW_ZERO_PRICE=false
