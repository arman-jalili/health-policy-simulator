# Local configuration example — copy to `.env`: `cp .env.example .env`
#
# Only variables that must be provided are active below. Everything else has a safe default in
# `src/shared/config.py`; uncomment a line to override it.
#
#   ENV                   local | staging | production            (default: local)
#   AUTH_MODE             demo | strict                           (default: demo)
#                         demo is refused when ENV=production (ADR-005)
#   PERSISTENCE           postgres | memory                       (default: postgres)
#                         memory is refused outside ENV=local; it is for tests and a
#                         database-less local demo only (restart loses the corpus)
#   DB_ECHO               true | false                            (default: false)
#   DB_POOL_SIZE          int, 1-50                               (default: 5)
#   DB_MAX_OVERFLOW       int, 0-50                               (default: 5)
#   DB_CONNECT_TIMEOUT_S  float, seconds                          (default: 5.0)
#   LOG_LEVEL             DEBUG | INFO | WARNING | ERROR          (default: INFO)
#   LOG_FORMAT            json | console                          (default: json)
#   API_HOST              bind address                            (default: 0.0.0.0)
#   API_PORT              listen port                             (default: 8000)
#   CORS_ORIGINS          JSON array, e.g. ["http://localhost:3000"] (default: [])

# PostgreSQL 16 + pgvector (see compose.yaml). The asyncpg driver is mandatory.
DATABASE_URL=postgresql+asyncpg://hps:hps@localhost:5433/health_policy
