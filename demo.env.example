# Live-model overrides for the demo stack — copy to `demo.env.local` (git-ignored).
#
#   cp demo.env.example demo.env.local
#   $EDITOR demo.env.local            # or export DEEPSEEK_API_KEY=sk-… and skip the file
#   make stack-live
#
# `docker compose up -d --force-recreate backend` is enough; `make stack-live` also prints the posture.
# The key is best kept in the environment: export DEEPSEEK_API_KEY=sk-… and leave LLM_API_KEY empty
# (the backend adopts it). Everything below except the key is safe to commit.

# ── DeepSeek (OpenAI-compatible) ────────────────────────────────────────────────────────────────
# Docs: https://api-docs.deepseek.com/  ·  base URL for the OpenAI format is https://api.deepseek.com
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com
# Models as of 2026-11: `deepseek-flash` (V4.1-Flash, recommended) and `deepseek-v4-pro`.
# `deepseek-chat` / `deepseek-reasoner` were retired on 2026-07-24 — do not use them.
LLM_MODEL=deepseek-flash
# LLM_API_KEY=sk-…   # optional; overrides DEEPSEEK_API_KEY
# DeepSeek defaults to *thinking* mode: temperature is ignored and output costs more. `none` selects
# non-thinking, which is what short JSON turns need. Leave empty for other providers.
LLM_REASONING_EFFORT=none
# Let the provider enforce JSON (`response_format={"type":"json_object"}`); the turn prompt already
# instructs JSON, and the parser rejects anything else.
LLM_JSON_MODE=true
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=800

# ── Metering ────────────────────────────────────────────────────────────────────────────────────
# Prices are per 1k tokens in the currency you report. DeepSeek bills USD; the UI formats EUR, so
# label the number on stage as one or the other. Peak list prices for deepseek-flash (cache miss):
# $0.30 / 1M input → 0.0003 per 1k · $1.20 / 1M output → 0.0012 per 1k (off-peak is half).
SIMULATION_MODEL_ID=deepseek-flash
SIMULATION_INPUT_PRICE_PER_1K=0.0003
SIMULATION_OUTPUT_PRICE_PER_1K=0.0012
# Keep this false with a real provider: at price 0 the budget guard could only stop by invocation count.
SIMULATION_ALLOW_ZERO_PRICE=false
