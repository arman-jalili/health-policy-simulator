# Live-model overrides for the demo stack — copy to `demo.env.local` (git-ignored).
#
#   cp demo.env.example demo.env.local
#   $EDITOR demo.env.local            # endpoint + model
#   export LLM_API_KEY=…              # credential, or put it in the root .env
#   make stack-live
#
# Any OpenAI-compatible `/chat/completions` endpoint works. Nothing here is vendor-specific; the
# examples below are commented so you can pick one.

# ── Provider (live model) ───────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Ask for a JSON object; the turn parser needs JSON. Set false if your server rejects the field.
LLM_JSON_MODE=true
# Optional, provider-specific reasoning control (low|medium|high). Leave empty if unsupported.
LLM_REASONING_EFFORT=
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=800

# Other endpoints, same shape — uncomment and adjust:
#   Azure AI Foundry   LLM_PROVIDER=azure_ai_foundry  LLM_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1
#   OpenRouter         LLM_BASE_URL=https://openrouter.ai/api/v1
#   Ollama (local)     LLM_BASE_URL=http://host.docker.internal:11434/v1   LLM_MODEL=llama3.1
#   vLLM / LM Studio   LLM_BASE_URL=http://host.docker.internal:8000/v1

# ── Metering ────────────────────────────────────────────────────────────────────────────────────
# Your provider's price per 1k tokens, in one currency. The UI formats EUR, so either report EUR or
# say "USD" on stage. With prices at 0 the budget guard can only stop by invocation count.
SIMULATION_MODEL_ID=scripted-local
SIMULATION_INPUT_PRICE_PER_1K=0
SIMULATION_OUTPUT_PRICE_PER_1K=0
SIMULATION_ALLOW_ZERO_PRICE=true
